{
  "name": "@trusportidentity/beacon-node",
  "version": "1.0.0",
  "description": "Official TrustPort Beacon APM and Telemetry SDK for Node.js, Express, NestJS and Next.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nestjs": {
      "types": "./dist/nestjs.d.ts",
      "default": "./dist/nestjs.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test test/*.test.js",
    "prepare": "tsc"
  },
  "keywords": [
    "apm",
    "observability",
    "tracing",
    "beacon",
    "nestjs",
    "express",
    "trustport"
  ],
  "author": "TrustPort",
  "license": "MIT",
  "peerDependencies": {
    "@nestjs/common": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "@nestjs/core": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@types/node": "^20.0.0",
    "rxjs": "^7.8.1",
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trustportidentity/beacon-node.git"
  },
  "homepage": "https://github.com/trustportidentity/beacon-node#readme",
  "bugs": {
    "url": "https://github.com/trustportidentity/beacon-node/issues"
  }
}
