{
  "name": "@trustportidentity/beacon-node",
  "version": "1.0.0",
  "description": "Official TrustPort Beacon APM and Telemetry SDK for Node.js, Express, and NestJS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
