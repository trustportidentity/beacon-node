      "types": "./dist/nestjs.d.ts",
      "default": "./dist/nestjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test test/*.test.js",
    "prepare": "tsc"
  },
  "keywords": [
    "apm",
    "observability",
    "tracing",
    "beacon",
    "nestjs",
    "express",
    "trustport"
  ],
